{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbench-web",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dash.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
