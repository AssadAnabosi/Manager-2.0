{
  "name": "@workbench/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "types": "wrangler types src/env.d.ts --env-interface Env",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply workbench-db --local",
    "db:seed:local": "bun scripts/seed.ts --local",
    "db:seed:remote": "bun scripts/render-wrangler.ts && bun scripts/seed.ts --remote",
    "db:reset:local": "bun scripts/reset-local.ts && bun run db:migrate:local && bun run db:seed:local",
    "deploy": "bun scripts/render-wrangler.ts && wrangler d1 migrations apply workbench-db --remote --config wrangler.deploy.jsonc && wrangler deploy --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@workbench/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "ms": "^2.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.9.1",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.53.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.162.0"
  }
}
